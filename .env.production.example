# ==============================================================================
# Nexus CRM Enterprise - Variáveis de Ambiente de Produção
# Segurança: Tríade CID, Zero Trust, AES-256-GCM, Scrypt & HMAC Webhooks
# ==============================================================================

# Ambiente & Servidor
NODE_ENV=production
PORT=3000

# Banco de Dados Relacional PostgreSQL 16 (com RLS ativado)
# Exemplo Supabase / Neon / Cloud SQL: postgresql://crm_user:PASSWORD@host:5432/nexus_crm_db
DATABASE_URL=postgresql://crm_user:crm_secure_password_2026@localhost:5432/nexus_crm_db

# Cache de Sessão & Rate Limiting (Redis)
REDIS_URL=redis://:redis_secure_pass_2026@localhost:6379

# Criptografia de Sessão (JWT HS256) - Gerar chave forte de 32+ bytes
JWT_SECRET=prod_crm_jwt_secret_zero_trust_super_secure_key_2026

# Criptografia de Campos em Repouso (AES-256-GCM) - Exatamente 32 bytes em hexadecimal (64 caracteres)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Segredo de Assinatura HMAC dos Webhooks de Faturamento (Stripe / Asaas / Kiwify)
WEBHOOK_HMAC_SECRET=whsec_prod_billing_nexus_crm_enterprise_hmac_2026

# Gateway de Pagamento Padrão ('asaas' | 'stripe' | 'kiwify')
BILLING_PROVIDER=asaas
BILLING_API_KEY=

# Links de Checkout Externos Opcionais (se preferir checkout hospedado no gateway)
CHECKOUT_STARTER_URL=
CHECKOUT_PRO_URL=
CHECKOUT_ENTERPRISE_URL=

# Inteligência Artificial Google Gemini (API Key oficial do Google AI Studio)
GEMINI_API_KEY=

# Limites de Taxa (Rate Limiting)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
