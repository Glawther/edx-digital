{
  "name": "edx-digital",
  "version": "3.19.0",
  "description": "EDX Digital: funil de vendas, clientes e tarefas para equipes pequenas",
  "main": "cloud.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test \"server/tests/*.test.js\" \"tests/unit/*.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-edx-digital",
    "test:rules": "node scripts/test-rules.mjs",
    "test:ui": "node --test --test-concurrency=1 \"tests/ui/*.test.mjs\"",
    "deploy": "npm run build && firebase deploy --only firestore:rules,functions,hosting",
    "build": "node scripts/build.mjs",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "gcp-build": "",
    "test:e2e": "node scripts/test-rules.mjs tests/e2e/account.test.mjs"
  },
  "keywords": [
    "crm",
    "edx-digital",
    "vendas",
    "funil",
    "firestore"
  ],
  "author": "Glawther Soares",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.25.10",
    "firebase-tools": "15.33.0",
    "playwright-core": "1.64.0"
  },
  "private": true,
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "engines": {
    "node": "22"
  }
}
