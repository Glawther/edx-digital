{
  "name": "edx-digital",
  "version": "2.0.0",
  "description": "EDX Digital - Sistema Comercial Enterprise com IA Gemini, Tríade CID (RBAC) e Google Cloud Firestore",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js || python -m http.server 3000",
    "start": "node server.js || python -m http.server 3000",
    "test": "node --test server/tests/*.test.js",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-edx-digital",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-edx-digital \"node --test tests/rules/\"",
    "deploy": "npx -y firebase-tools deploy --only hosting"
  },
  "keywords": [
    "crm",
    "edx-digital",
    "sales",
    "gemini-ai",
    "firestore",
    "rbac",
    "triade-cid",
    "kanban",
    "business"
  ],
  "author": "EDX Digital Team",
  "license": "MIT"
}
