rules_version = '2';

// Regras de acesso do EDX Digital.
//
// Princípio: ninguém lê nem grava nada sem estar autenticado, e cada pessoa só alcança os
// dados da empresa a que pertence. O perfil (users/{uid}) diz qual é a empresa e o papel;
// ele não pode ser alterado pela própria pessoa.
//
// Testes: `npm run test:rules` (emulador local). Detalhes em docs/LOGIN_E_SEGURANCA.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    // Membro ativo da empresa (quem foi bloqueado deixa de ser)
    function isMember(orgId) {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && myProfile().orgId == orgId
        && myProfile().status == 'active';
    }

    function isOrgAdmin(orgId) {
      return isMember(orgId) && myProfile().role == 'admin';
    }

    function orgOwner(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid;
    }

    // ---- situação do plano -------------------------------------------------
    // Período de teste: 14 dias, com o fim gravado na criação da empresa e conferido aqui.
    // Plano pago: vale até paidUntilMs, gravado só pelo servidor de cobrança, com 3 dias de tolerância.
    // Com o plano vencido a empresa fica em modo de leitura: vê, exporta e exclui, mas não cria nem altera.
    function trialMs() { return 14 * 24 * 60 * 60 * 1000; }
    function graceMs() { return 3 * 24 * 60 * 60 * 1000; }

    function planAllowsWrites(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      let now = request.time.toMillis();
      return org.planStatus == 'active'
        ? ('paidUntilMs' in org && now < org.paidUntilMs + graceMs())
        // empresas criadas antes desta regra não têm trialEndsAtMs e seguem liberadas
        : (!('trialEndsAtMs' in org) || now < org.trialEndsAtMs);
    }

    function trialClaim() {
      return get(/databases/$(database)/documents/trial_claims/$(request.auth.token.email)).data;
    }

    // ---- limites do plano -------------------------------------------------
    // O servidor conta as oportunidades em aberto e as pessoas com acesso a cada alteração e
    // grava na empresa se o plano está cheio (usage.leadsFull, usage.seatsFull). O aplicativo
    // não consegue mexer nesse campo. Empresas sem o campo seguem liberadas.
    function usageFull(orgId, what) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('usage', {}).get(what, false) == true;
    }

    function validStages() {
      // 'contacted' é o nome antigo de 'contact'; fica aceito por causa de registros antigos
      return ['lead', 'contact', 'contacted', 'proposal', 'negotiation', 'won', 'lost'];
    }

    // Um texto opcional: ausente, nulo ou texto até o tamanho dado
    function optText(data, field, max) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= max);
    }

    function optList(data, field, max) {
      return !(field in data) || (data[field] is list && data[field].size() <= max);
    }

    // Os tipos são conferidos porque um registro malformado travaria a tela de quem o abrisse
    function validCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && data.stage in validStages()
        && (!('dealValue' in data) || (data.dealValue is number && data.dealValue >= 0))
        && data.orgId is string
        && optText(data, 'company', 300) && optText(data, 'role', 300)
        && optText(data, 'email', 320) && optText(data, 'phone', 60)
        && optText(data, 'notes', 20000) && optText(data, 'priority', 20)
        && optText(data, 'expectedCloseDate', 40) && optText(data, 'lossDetails', 2000)
        && optList(data, 'tags', 30) && optList(data, 'tasks', 500) && optList(data, 'activities', 2000)
        && (!('assignedTo' in data) || data.assignedTo == null || data.assignedTo is map)
        && (!('custom' in data) || data.custom is map);
    }

    function assignedToMe(data) {
      return 'assignedTo' in data && data.assignedTo.id == request.auth.uid;
    }

    // ---------------------------------------------------------------- perfis

    match /users/{uid} {
      // A própria pessoa e os colegas da mesma empresa. CPF e telefone não ficam aqui.
      allow read: if signedIn()
        && (request.auth.uid == uid || isMember(resource.data.orgId));

      allow create: if signedIn() && validNewProfile(request.resource.data) && (
        // 1. quem acabou de registrar a empresa vira o primeiro administrador dela
        (request.auth.uid == uid
          && request.resource.data.role == 'admin'
          && request.resource.data.email == request.auth.token.email
          && orgOwner(request.resource.data.orgId) == uid)
        // 2. quem tem o código de convite entra como vendedor
        || (request.auth.uid == uid
          && request.resource.data.role == 'employee'
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.inviteCode is string
          && inviteOpens(request.resource.data.inviteCode, request.resource.data.orgId)
          && !usageFull(request.resource.data.orgId, 'seatsFull'))
        // 3. o administrador cadastra alguém da própria empresa
        || (request.auth.uid != uid && isOrgAdmin(request.resource.data.orgId)
          && !usageFull(request.resource.data.orgId, 'seatsFull'))
      );

      allow update: if signedIn() && (
        // a própria pessoa: o nome, o aviso de troca de senha e se quer o resumo diário por e-mail
        (request.auth.uid == uid
          && validName(request.resource.data.name)
          && (!('emailDigest' in request.resource.data) || request.resource.data.emailDigest is bool)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'mustChangePassword', 'emailDigest', 'updatedAt']))
        // o administrador: dados de outra pessoa da empresa, menos do dono
        || (request.auth.uid != uid
          && isOrgAdmin(resource.data.orgId)
          && orgOwner(resource.data.orgId) != uid
          && validName(request.resource.data.name)
          && request.resource.data.role in ['admin', 'employee']
          && request.resource.data.status in ['active', 'blocked']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'role', 'status', 'jobTitle', 'department', 'mustChangePassword', 'updatedAt']))
      );

      allow delete: if signedIn() && (
        // o administrador remove outra pessoa da empresa (menos o dono)
        (request.auth.uid != uid
          && isOrgAdmin(resource.data.orgId)
          && orgOwner(resource.data.orgId) != uid)
        // a própria pessoa exclui a sua conta; o dono só depois de excluir a empresa.
        // Quem foi bloqueado não se exclui: apagaria o bloqueio e voltaria pelo convite.
        || (request.auth.uid == uid
          && resource.data.status == 'active'
          && (!exists(/databases/$(database)/documents/organizations/$(resource.data.orgId))
              || orgOwner(resource.data.orgId) != uid))
      );
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 200;
    }

    function validNewProfile(data) {
      return data.orgId is string
        && data.role in ['admin', 'employee']
        && data.status == 'active'
        && validName(data.name)
        && data.email is string && data.email.size() <= 320;
    }

    function inviteOpens(code, orgId) {
      let invite = get(/databases/$(database)/documents/invites/$(code)).data;
      return invite.active == true && invite.orgId == orgId;
    }

    // CPF e telefone dos colaboradores: só a própria pessoa e os administradores da empresa
    match /user_private/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isOrgAdmin(resource.data.orgId));
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow update: if isOrgAdmin(resource.data.orgId)
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn()
        && (request.auth.uid == uid || isOrgAdmin(resource.data.orgId));
    }

    // ---------------------------------------------------------------- empresas

    match /organizations/{orgId} {
      allow read: if isMember(orgId);

      // Uma conta sem empresa pode registrar a sua, sempre em período de teste
      allow create: if signedIn()
        // só com o e-mail confirmado: um endereço inventado não abre empresa nem ganha teste
        && request.auth.token.email_verified == true
        && !exists(profilePath(request.auth.uid))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.plan in ['starter', 'pro', 'enterprise']
        && request.resource.data.planStatus == 'trial'
        // o fim do teste é o que ficou registrado para este e-mail (trial_claims): quem já usou
        // o teste e cria outra empresa recebe a mesma data, não 14 dias novos
        && request.resource.data.trialEndsAtMs is int
        && request.resource.data.trialEndsAtMs == trialClaim().trialEndsAtMs
        && !('paidUntilMs' in request.resource.data);

      // O plano e a situação do pagamento não são alteráveis pelo aplicativo
      allow update: if isOrgAdmin(orgId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'legalName', 'cnpj', 'logoUrl', 'brandColor', 'teamInviteCode', 'stageNames', 'customFields', 'messageTemplates', 'monthlyGoal', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && optText(request.resource.data, 'legalName', 300) && optText(request.resource.data, 'cnpj', 40)
        // o logotipo pode ser uma imagem embutida; o app a reduz antes de salvar
        && optText(request.resource.data, 'logoUrl', 400000) && optText(request.resource.data, 'brandColor', 20)
        // nomes de etapa e campos extras da empresa: listas pequenas, para não inflar o registro
        && (!('stageNames' in request.resource.data)
            || (request.resource.data.stageNames is map && request.resource.data.stageNames.size() <= 6))
        && (!('customFields' in request.resource.data)
            || (request.resource.data.customFields is list && request.resource.data.customFields.size() <= 8))
        && (!('messageTemplates' in request.resource.data)
            || (request.resource.data.messageTemplates is list && request.resource.data.messageTemplates.size() <= 12))
        && (!('monthlyGoal' in request.resource.data)
            || (request.resource.data.monthlyGoal is number && request.resource.data.monthlyGoal >= 0));

      // Só o dono exclui a empresa (direito de eliminação dos dados)
      allow delete: if isOrgAdmin(orgId) && resource.data.ownerUid == request.auth.uid;
    }

    // ---------------------------------------------------------------- teste gratuito

    // Um registro por e-mail, com a data em que o teste dele termina. Criado uma vez, antes da
    // empresa; nunca alterado nem apagado, nem quando a conta e a empresa são excluídas.
    match /trial_claims/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.token.email == email
        && request.resource.data.trialEndsAtMs is int
        // no máximo 14 dias a partir de agora (com 5 minutos de folga de relógio)
        && request.resource.data.trialEndsAtMs <= request.time.toMillis() + trialMs() + 5 * 60 * 1000
        && request.resource.data.keys().hasOnly(['trialEndsAtMs', 'createdAt']);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- convites

    match /invites/{code} {
      // Quem tem o código confere se ele vale; ninguém consegue listar os códigos
      allow get: if true;
      allow list: if false;
      allow create: if isOrgAdmin(request.resource.data.orgId)
        && request.resource.data.role == 'employee'
        && request.resource.data.active is bool;
      allow update: if isOrgAdmin(resource.data.orgId)
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.role == 'employee';
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // ---------------------------------------------------------------- clientes

    match /customers/{customerId} {
      // O administrador vê a empresa inteira; o vendedor, só a própria carteira
      allow read: if isOrgAdmin(resource.data.orgId)
        || (isMember(resource.data.orgId) && assignedToMe(resource.data));

      allow create: if validCustomer(request.resource.data)
        // o identificador aparece em telas de outras pessoas da empresa: só os caracteres que o app gera
        && customerId.matches('^[A-Za-z0-9_-]{1,120}$')
        && planAllowsWrites(request.resource.data.orgId)
        && !usageFull(request.resource.data.orgId, 'leadsFull')
        && (
          isOrgAdmin(request.resource.data.orgId)
          || (isMember(request.resource.data.orgId) && assignedToMe(request.resource.data))
        );

      allow update: if validCustomer(request.resource.data)
        && request.resource.data.orgId == resource.data.orgId
        && planAllowsWrites(resource.data.orgId)
        && (
          isOrgAdmin(resource.data.orgId)
          || (isMember(resource.data.orgId)
              && assignedToMe(resource.data)
              && assignedToMe(request.resource.data))
        );

      // Só o administrador exclui (continua valendo com o plano vencido: o dado é da empresa)
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // ---------------------------------------------------------------- auditoria

    match /audit_logs/{logId} {
      allow read: if isOrgAdmin(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId)
        && request.resource.data.userId == request.auth.uid
        // o papel gravado é o papel real; o nome é resolvido pela tela a partir do userId
        && request.resource.data.get('userRole', myProfile().role) == myProfile().role
        && request.resource.data.action is string && request.resource.data.action.size() <= 80
        && request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 40
        && optText(request.resource.data, 'userName', 200) && optText(request.resource.data, 'userEmail', 320)
        && optText(request.resource.data, 'severity', 20)
        && (!('details' in request.resource.data) || request.resource.data.details is map)
        && request.resource.data.keys().hasOnly(['id', 'action', 'severity', 'timestamp', 'userId', 'userName', 'userEmail', 'userRole', 'orgId', 'orgName', 'details']);
      allow update: if false; // o registro não pode ser alterado
      // Só é apagado pelo dono, ao excluir a empresa inteira
      allow delete: if isOrgAdmin(resource.data.orgId)
        && orgOwner(resource.data.orgId) == request.auth.uid;
    }

    // ---------------------------------------------------------------- cobranças

    // Criadas e alteradas só pelo servidor de cobrança. O administrador pode ver as da sua empresa.
    match /payments/{paymentId} {
      allow read: if isOrgAdmin(resource.data.orgId);
      allow write: if false;
    }

    // Tudo o que não está listado acima fica fechado (inclusive as coleções antigas
    // employees e system_config, que eram públicas).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
