rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Validação estrita de tipo e integridade para Clientes (Tríade CID)
    function isValidCustomerData(data) {
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 300)) &&
             (!('dealValue' in data) || (data.dealValue is number && data.dealValue >= 0)) &&
             (!('stage' in data) || (data.stage is string && data.stage in validStages()));
    }

    // O app grava o estágio "Primeiro Contato" como 'contact'. A lista antiga só tinha 'contacted',
    // então mover ou criar um lead nesse estágio era recusado e o cartão voltava sozinho.
    function validStages() {
      return ['lead', 'contact', 'contacted', 'proposal', 'negotiation', 'won', 'lost'];
    }

    // 1. Coleção de Clientes e Oportunidades (Customers)
    // Sincronização multi-cliente em tempo real via onSnapshot
    match /customers/{customerId} {
      allow read: if true;
      allow create: if request.resource.data.name is string && 
                       request.resource.data.stage in validStages();
      allow update: if isValidCustomerData(request.resource.data);
      allow delete: if true;
    }

    // 2. Trilha de Auditoria Imutável (Audit Trail)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['action', 'timestamp']);
      allow update, delete: if false; // Estritamente imutável
    }

    // 3. Coleção de Configurações
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // 4. Coleção de Funcionários & Credenciais Corporativas (CID / RBAC)
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // 5. Coleção de Organizações Comerciais e Whitelabel (Multi-tenant SaaS)
    match /organizations/{orgId} {
      allow read, write: if true;
      
      // Subcoleção dedicada de clientes isolados por empresa
      match /customers/{customerId} {
        allow read, write: if true;
      }
    }
  }
}
