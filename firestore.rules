rules_version = '2';

// Regras de acesso do EDX Digital.
//
// Princípio: ninguém lê nem grava nada sem estar autenticado, e cada pessoa só alcança os
// dados da empresa a que pertence. O perfil (users/{uid}) diz qual é a empresa e o papel;
// ele não pode ser alterado pela própria pessoa.
//
// Testes: `npm run test:rules` (emulador local). Detalhes em docs/LOGIN_E_SEGURANCA.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    // Membro ativo da empresa (quem foi bloqueado deixa de ser)
    function isMember(orgId) {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && myProfile().orgId == orgId
        && myProfile().status == 'active';
    }

    function isOrgAdmin(orgId) {
      return isMember(orgId) && myProfile().role == 'admin';
    }

    function orgOwner(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid;
    }

    // ---- situação do plano -------------------------------------------------
    // Período de teste: 14 dias, com o fim gravado na criação da empresa e conferido aqui.
    // Plano pago: vale até paidUntilMs, gravado só pelo servidor de cobrança, com 3 dias de tolerância.
    // Com o plano vencido a empresa fica em modo de leitura: vê, exporta e exclui, mas não cria nem altera.
    function trialMs() { return 14 * 24 * 60 * 60 * 1000; }
    function graceMs() { return 3 * 24 * 60 * 60 * 1000; }

    function planAllowsWrites(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      let now = request.time.toMillis();
      return org.planStatus == 'active'
        ? ('paidUntilMs' in org && now < org.paidUntilMs + graceMs())
        // empresas criadas antes desta regra não têm trialEndsAtMs e seguem liberadas
        : (!('trialEndsAtMs' in org) || now < org.trialEndsAtMs);
    }

    function validStages() {
      // 'contacted' é o nome antigo de 'contact'; fica aceito por causa de registros antigos
      return ['lead', 'contact', 'contacted', 'proposal', 'negotiation', 'won', 'lost'];
    }

    function validCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && data.stage in validStages()
        && (!('dealValue' in data) || (data.dealValue is number && data.dealValue >= 0))
        && data.orgId is string;
    }

    function assignedToMe(data) {
      return 'assignedTo' in data && data.assignedTo.id == request.auth.uid;
    }

    // ---------------------------------------------------------------- perfis

    match /users/{uid} {
      // A própria pessoa e os colegas da mesma empresa. CPF e telefone não ficam aqui.
      allow read: if signedIn()
        && (request.auth.uid == uid || isMember(resource.data.orgId));

      allow create: if signedIn() && validNewProfile(request.resource.data) && (
        // 1. quem acabou de registrar a empresa vira o primeiro administrador dela
        (request.auth.uid == uid
          && request.resource.data.role == 'admin'
          && request.resource.data.email == request.auth.token.email
          && orgOwner(request.resource.data.orgId) == uid)
        // 2. quem tem o código de convite entra como vendedor
        || (request.auth.uid == uid
          && request.resource.data.role == 'employee'
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.inviteCode is string
          && inviteOpens(request.resource.data.inviteCode, request.resource.data.orgId))
        // 3. o administrador cadastra alguém da própria empresa
        || (request.auth.uid != uid && isOrgAdmin(request.resource.data.orgId))
      );

      allow update: if signedIn() && (
        // a própria pessoa: só o nome e o aviso de troca de senha
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'mustChangePassword', 'updatedAt']))
        // o administrador: dados de outra pessoa da empresa, menos do dono
        || (request.auth.uid != uid
          && isOrgAdmin(resource.data.orgId)
          && orgOwner(resource.data.orgId) != uid
          && request.resource.data.role in ['admin', 'employee']
          && request.resource.data.status in ['active', 'blocked']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'role', 'status', 'jobTitle', 'department', 'mustChangePassword', 'updatedAt']))
      );

      allow delete: if signedIn() && (
        // o administrador remove outra pessoa da empresa (menos o dono)
        (request.auth.uid != uid
          && isOrgAdmin(resource.data.orgId)
          && orgOwner(resource.data.orgId) != uid)
        // a própria pessoa exclui a sua conta; o dono só depois de excluir a empresa
        || (request.auth.uid == uid
          && (!exists(/databases/$(database)/documents/organizations/$(resource.data.orgId))
              || orgOwner(resource.data.orgId) != uid))
      );
    }

    function validNewProfile(data) {
      return data.orgId is string
        && data.role in ['admin', 'employee']
        && data.status == 'active'
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string;
    }

    function inviteOpens(code, orgId) {
      let invite = get(/databases/$(database)/documents/invites/$(code)).data;
      return invite.active == true && invite.orgId == orgId;
    }

    // CPF e telefone dos colaboradores: só a própria pessoa e os administradores da empresa
    match /user_private/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isOrgAdmin(resource.data.orgId));
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow update: if isOrgAdmin(resource.data.orgId)
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn()
        && (request.auth.uid == uid || isOrgAdmin(resource.data.orgId));
    }

    // ---------------------------------------------------------------- empresas

    match /organizations/{orgId} {
      allow read: if isMember(orgId);

      // Uma conta sem empresa pode registrar a sua, sempre em período de teste
      allow create: if signedIn()
        && !exists(profilePath(request.auth.uid))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.plan in ['starter', 'pro', 'enterprise']
        && request.resource.data.planStatus == 'trial'
        // o fim do teste é obrigatório e não pode passar de 14 dias a partir de agora
        && request.resource.data.trialEndsAtMs is int
        && request.resource.data.trialEndsAtMs <= request.time.toMillis() + trialMs() + 5 * 60 * 1000
        && !('paidUntilMs' in request.resource.data);

      // O plano e a situação do pagamento não são alteráveis pelo aplicativo
      allow update: if isOrgAdmin(orgId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'legalName', 'cnpj', 'logoUrl', 'brandColor', 'teamInviteCode', 'updatedAt']);

      // Só o dono exclui a empresa (direito de eliminação dos dados)
      allow delete: if isOrgAdmin(orgId) && resource.data.ownerUid == request.auth.uid;
    }

    // ---------------------------------------------------------------- convites

    match /invites/{code} {
      // Quem tem o código confere se ele vale; ninguém consegue listar os códigos
      allow get: if true;
      allow list: if false;
      allow create: if isOrgAdmin(request.resource.data.orgId)
        && request.resource.data.role == 'employee'
        && request.resource.data.active is bool;
      allow update: if isOrgAdmin(resource.data.orgId)
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.role == 'employee';
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // ---------------------------------------------------------------- clientes

    match /customers/{customerId} {
      // O administrador vê a empresa inteira; o vendedor, só a própria carteira
      allow read: if isOrgAdmin(resource.data.orgId)
        || (isMember(resource.data.orgId) && assignedToMe(resource.data));

      allow create: if validCustomer(request.resource.data)
        && planAllowsWrites(request.resource.data.orgId)
        && (
          isOrgAdmin(request.resource.data.orgId)
          || (isMember(request.resource.data.orgId) && assignedToMe(request.resource.data))
        );

      allow update: if validCustomer(request.resource.data)
        && request.resource.data.orgId == resource.data.orgId
        && planAllowsWrites(resource.data.orgId)
        && (
          isOrgAdmin(resource.data.orgId)
          || (isMember(resource.data.orgId)
              && assignedToMe(resource.data)
              && assignedToMe(request.resource.data))
        );

      // Só o administrador exclui (continua valendo com o plano vencido: o dado é da empresa)
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // ---------------------------------------------------------------- auditoria

    match /audit_logs/{logId} {
      allow read: if isOrgAdmin(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['action', 'timestamp']);
      allow update: if false; // o registro não pode ser alterado
      // Só é apagado pelo dono, ao excluir a empresa inteira
      allow delete: if isOrgAdmin(resource.data.orgId)
        && orgOwner(resource.data.orgId) == request.auth.uid;
    }

    // ---------------------------------------------------------------- cobranças

    // Criadas e alteradas só pelo servidor de cobrança. O administrador pode ver as da sua empresa.
    match /payments/{paymentId} {
      allow read: if isOrgAdmin(resource.data.orgId);
      allow write: if false;
    }

    // Tudo o que não está listado acima fica fechado (inclusive as coleções antigas
    // employees e system_config, que eram públicas).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
