# EDX Digital - variáveis de server.js, o servidor do seu computador
# Em produção o servidor é uma função do Firebase e os segredos ficam no Secret Manager.
# Passo a passo: docs/COBRANCA_PIX.md

PORT=3000
NODE_ENV=development

# Projeto do Firebase onde estão as empresas e os pagamentos
FIREBASE_PROJECT_ID=nexuscrm-d8e13

# Só para desenvolvimento, com os emuladores do Firebase (ignoradas em produção)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
