# EDX Digital - variáveis do servidor (server.js)
# Em produção elas ficam no painel do Render, nunca em arquivo. Passo a passo: docs/COBRANCA_PIX.md

PORT=3000
NODE_ENV=development

# Projeto do Firebase onde estão as empresas e os pagamentos
FIREBASE_PROJECT_ID=nexuscrm-d8e13

# Endereço público deste servidor (o Mercado Pago avisa os pagamentos nele)
PUBLIC_API_URL=

# Segredos: preencha só no painel do Render
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT=

# Só para desenvolvimento, com os emuladores do Firebase (ignoradas em produção)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
